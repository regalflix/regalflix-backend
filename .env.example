# Copia questo file in ".env" e compila i valori veri prima di avviare il progetto.
# NON committare mai il file ".env" reale (contiene credenziali).

# --- Database -----------------------------------------------------------
# Stringa di connessione Postgres. Su Render/Railway/Supabase la trovi
# nella dashboard del database appena creato.
DATABASE_URL="postgresql://utente:password@host:5432/regalflix?schema=public"

# --- Email transazionali (Postmark / SendGrid / Brevo / SES...) ---------
# Qualsiasi provider con credenziali SMTP standard funziona senza toccare il codice.
SMTP_HOST="smtp.postmarkapp.com"
SMTP_PORT=587
SMTP_USER="il-tuo-smtp-user"
SMTP_PASS="la-tua-smtp-password"
EMAIL_FROM="REGALFLIX <no-reply@regalflix.it>"

# --- App ------------------------------------------------------------------
# URL pubblico del sito REGALFLIX (usato per generare i link nelle email).
APP_BASE_URL="https://www.regalflix.it"
# URL da cui il frontend chiamerà queste API (per il CORS). In sviluppo puoi
# lasciare "*" (già di default), in produzione mettilo esatto.
FRONTEND_ORIGIN="https://www.regalflix.it"

PORT=3000

# Metti "true" solo se NON usi un cron esterno dell'hosting per i promemoria
# (vedi il README, sezione "Promemoria e scadenze automatiche").
ENABLE_INTERNAL_CRON=false
